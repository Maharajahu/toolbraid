{
  "name": "toolbraid",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A browser-native semantic and policy control plane for safe, explainable, human-approved WebMCP execution across sites.",
  "keywords": [
    "webmcp",
    "mcp",
    "ai-agents",
    "browser-extension",
    "human-in-the-loop"
  ],
  "homepage": "https://toolbraid-webmcp.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maharajahu/toolbraid.git"
  },
  "bugs": {
    "url": "https://github.com/Maharajahu/toolbraid/issues"
  },
  "author": "Maharajahu",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "dev:native": "node scripts/serve-multi-origin.mjs",
    "test": "node --test tests/v2/*.test.mjs",
    "test:v2": "node --test tests/v2/*.test.mjs",
    "test:universal": "node --test tests/universal/*.test.mjs",
    "test:bridge": "node --test tests/universal/extension-native-mcp-bridge.test.mjs tests/universal/mcp-bridge-server.test.mjs",
    "test:universal:e2e": "node scripts/e2e-universal-extension.mjs --json",
    "test:e2e": "python scripts/e2e.py",
    "test:native": "python scripts/e2e-native.py",
    "check": "node scripts/check-project.mjs",
    "validate": "node scripts/check-project.mjs && node --test tests/v2/*.test.mjs && node scripts/smoke.mjs && node scripts/build-standalone.mjs",
    "validate:full": "npm run validate && python scripts/e2e.py",
    "smoke": "node scripts/smoke.mjs",
    "build": "node scripts/build-standalone.mjs",
    "build:extension": "node scripts/build-universal-extension.mjs",
    "bridge:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-mcp-bridge.ps1",
    "build:vercel": "node scripts/build-vercel-multi-origin.mjs",
    "build:vercel:stable": "node scripts/build-vercel-stable-projects.mjs",
    "validate:vercel": "node scripts/build-vercel-multi-origin.mjs && node --test tests/v2/vercel-multi-origin-deployment.test.mjs",
    "validate:vercel:stable": "node scripts/build-vercel-stable-projects.mjs && node --test tests/v2/vercel-stable-projects.test.mjs",
    "deploy:vercel:stable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-vercel-stable.ps1",
    "validate:universal": "npm run test:universal && npm run build:extension && npm run test:v2 && npm run check",
    "validate:ci": "npm run validate"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
