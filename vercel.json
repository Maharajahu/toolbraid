{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-vercel-multi-origin.mjs",
  "outputDirectory": "dist/vercel-multi-origin",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "app.toolbraid.dev" }],
      "destination": "/_toolbraid_origins/app/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "app.toolbraid.dev" }],
      "destination": "/_toolbraid_origins/app/:path*"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "signals.toolbraid.dev" }],
      "destination": "/_toolbraid_origins/signals/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "signals.toolbraid.dev" }],
      "destination": "/_toolbraid_origins/signals/:path*"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "pulse.toolbraid.dev" }],
      "destination": "/_toolbraid_origins/pulse/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pulse.toolbraid.dev" }],
      "destination": "/_toolbraid_origins/pulse/:path*"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "source.toolbraid.dev" }],
      "destination": "/_toolbraid_origins/source/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "source.toolbraid.dev" }],
      "destination": "/_toolbraid_origins/source/:path*"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "deploy.toolbraid.dev" }],
      "destination": "/_toolbraid_origins/deploy/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "deploy.toolbraid.dev" }],
      "destination": "/_toolbraid_origins/deploy/:path*"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "status.toolbraid.dev" }],
      "destination": "/_toolbraid_origins/status/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "status.toolbraid.dev" }],
      "destination": "/_toolbraid_origins/status/:path*"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "mirage.toolbraid.dev" }],
      "destination": "/_toolbraid_origins/mirage/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mirage.toolbraid.dev" }],
      "destination": "/_toolbraid_origins/mirage/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "app.toolbraid.dev" }],
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://signals.toolbraid.dev https://pulse.toolbraid.dev https://source.toolbraid.dev https://deploy.toolbraid.dev https://status.toolbraid.dev https://mirage.toolbraid.dev; frame-src https://signals.toolbraid.dev https://pulse.toolbraid.dev https://source.toolbraid.dev https://deploy.toolbraid.dev https://status.toolbraid.dev https://mirage.toolbraid.dev; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        {
          "key": "Permissions-Policy",
          "value": "tools=(self \"https://signals.toolbraid.dev\" \"https://pulse.toolbraid.dev\" \"https://source.toolbraid.dev\" \"https://deploy.toolbraid.dev\" \"https://status.toolbraid.dev\" \"https://mirage.toolbraid.dev\")"
        },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "signals.toolbraid.dev" }],
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors https://app.toolbraid.dev" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Permissions-Policy", "value": "tools=(self \"https://app.toolbraid.dev\")" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "pulse.toolbraid.dev" }],
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors https://app.toolbraid.dev" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Permissions-Policy", "value": "tools=(self \"https://app.toolbraid.dev\")" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "source.toolbraid.dev" }],
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors https://app.toolbraid.dev" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Permissions-Policy", "value": "tools=(self \"https://app.toolbraid.dev\")" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "deploy.toolbraid.dev" }],
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors https://app.toolbraid.dev" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Permissions-Policy", "value": "tools=(self \"https://app.toolbraid.dev\")" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "status.toolbraid.dev" }],
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors https://app.toolbraid.dev" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Permissions-Policy", "value": "tools=(self \"https://app.toolbraid.dev\")" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mirage.toolbraid.dev" }],
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors https://app.toolbraid.dev" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Permissions-Policy", "value": "tools=(self \"https://app.toolbraid.dev\")" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
