# GitHub sandbox: commit reads plus incident issue reads/comments.
TOOLBRAID_GITHUB_TOKEN=github_pat_replace_me
TOOLBRAID_GITHUB_REPOSITORY=Maharajahu/toolbraid
TOOLBRAID_GITHUB_REF=
TOOLBRAID_GITHUB_INCIDENT_ISSUE=replace_with_issue_number

# Vercel recovery lab: deployment reads plus approved rollback.
TOOLBRAID_VERCEL_TOKEN=replace_with_vercel_token
TOOLBRAID_VERCEL_PROJECT_ID=prj_replace_me
TOOLBRAID_VERCEL_TEAM_ID=
TOOLBRAID_VERCEL_ENVIRONMENT=production
TOOLBRAID_VERCEL_PRODUCTION_ALIAS=toolbraid-recovery-lab.vercel.app
TOOLBRAID_VERCEL_HEALTH_URL=https://toolbraid-recovery-lab.vercel.app/api/health

# Generate a unique random value of at least 32 bytes. Never commit the real value.
TOOLBRAID_RECOVERY_SIGNING_SECRET=

# Optional bounded runtime controls.
TOOLBRAID_RECOVERY_QUOTE_TTL_SECONDS=120
TOOLBRAID_VERCEL_ROLLBACK_POLL_MS=1000
TOOLBRAID_VERCEL_ROLLBACK_MAX_POLLS=45
TOOLBRAID_HEALTH_TIMEOUT_MS=5000
